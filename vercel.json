{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index" },
    { "source": "/bubble-gun", "destination": "/products/bubble-gun" },
    { "source": "/stunt-pet", "destination": "/products/stunt-pet" },
    { "source": "/cute-dinos", "destination": "/products/cute-dinos" },
    { "source": "/mini-cool-car", "destination": "/products/mini-cool-car" },
    { "source": "/gel-storm", "destination": "/products/gel-storm" },
    { "source": "/pixel-splash", "destination": "/products/pixel-splash" },
    { "source": "/mecha-rover", "destination": "/products/mecha-rover" },
    { "source": "/help", "destination": "/help.html" }
  ],
  "redirects": [
    { "source": "/products/bubble-gun", "destination": "/bubble-gun", "permanent": true },
    { "source": "/products/stunt-pet", "destination": "/stunt-pet", "permanent": true },
    { "source": "/products/cute-dinos", "destination": "/cute-dinos", "permanent": true },
    { "source": "/products/mini-cool-car", "destination": "/mini-cool-car", "permanent": true },
    { "source": "/products/gel-storm", "destination": "/gel-storm", "permanent": true },
    { "source": "/products/pixel-splash", "destination": "/pixel-splash", "permanent": true },
    { "source": "/products/mecha-rover", "destination": "/mecha-rover", "permanent": true },
    { "source": "/barsaat", "destination": "/", "permanent": false },
    { "source": "/products/barsaat", "destination": "/", "permanent": false },
    { "source": "/agni", "destination": "/", "permanent": false },
    { "source": "/products/agni", "destination": "/", "permanent": false },
    { "source": "/noor", "destination": "/", "permanent": false },
    { "source": "/products/noor", "destination": "/", "permanent": false },
    { "source": "/aarav", "destination": "/", "permanent": false },
    { "source": "/products/aarav", "destination": "/", "permanent": false },
    { "source": "/pins-and-art-print", "destination": "/", "permanent": false },
    { "source": "/products/pins-and-art-print", "destination": "/", "permanent": false },
    { "source": "/action-keychains", "destination": "/", "permanent": false },
    { "source": "/products/action-keychains", "destination": "/", "permanent": false },
    { "source": "/character-mug", "destination": "/", "permanent": false },
    { "source": "/products/character-mug", "destination": "/", "permanent": false },
    { "source": "/iphone-15-case", "destination": "/", "permanent": false },
    { "source": "/products/iphone-15-case", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/comics/(.*).webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
