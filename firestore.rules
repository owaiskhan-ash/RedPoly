rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'ashketchupkeke@gmail.com';
    }

    function isValidSkuSlug(slug) {
      return slug in [
        'bubble-gun',
        'stunt-pet',
        'mini-cool-car',
        'gel-storm',
        'mecha-rover',
        'pixel-splash',
        'cute-dinos-green',
        'cute-dinos-red',
        'cute-dinos-teal',
        'cute-dinos-trio',
        'magnetic-blocks-25-pcs',
        'magnetic-blocks-36-pcs',
        'magnetic-blocks-42-pcs',
        'magnetic-blocks-64-pcs'
      ];
    }

    function skuSlugForName(name) {
      return name == 'BUBBLE GUN' ? 'bubble-gun' :
        name == 'STUNT PET' ? 'stunt-pet' :
        name == 'MINI COOL CAR' ? 'mini-cool-car' :
        name == 'GEL STORM' ? 'gel-storm' :
        name == 'MECHA ROVER' ? 'mecha-rover' :
        name == 'PIXEL SPLASH' ? 'pixel-splash' :
        name == 'CUTE DINOS GREEN' ? 'cute-dinos-green' :
        name == 'CUTE DINOS RED' ? 'cute-dinos-red' :
        name == 'CUTE DINOS TEAL' ? 'cute-dinos-teal' :
        name == 'CUTE DINOS TRIO' ? 'cute-dinos-trio' :
        name == 'MAGNETIC BLOCKS 25 PCS' ? 'magnetic-blocks-25-pcs' :
        name == 'MAGNETIC BLOCKS 36 PCS' ? 'magnetic-blocks-36-pcs' :
        name == 'MAGNETIC BLOCKS 42 PCS' ? 'magnetic-blocks-42-pcs' :
        name == 'MAGNETIC BLOCKS 64 PCS' ? 'magnetic-blocks-64-pcs' : '';
    }

    function nameForSkuSlug(slug) {
      return slug == 'bubble-gun' ? 'BUBBLE GUN' :
        slug == 'stunt-pet' ? 'STUNT PET' :
        slug == 'mini-cool-car' ? 'MINI COOL CAR' :
        slug == 'gel-storm' ? 'GEL STORM' :
        slug == 'mecha-rover' ? 'MECHA ROVER' :
        slug == 'pixel-splash' ? 'PIXEL SPLASH' :
        slug == 'cute-dinos-green' ? 'CUTE DINOS GREEN' :
        slug == 'cute-dinos-red' ? 'CUTE DINOS RED' :
        slug == 'cute-dinos-teal' ? 'CUTE DINOS TEAL' :
        slug == 'cute-dinos-trio' ? 'CUTE DINOS TRIO' :
        slug == 'magnetic-blocks-25-pcs' ? 'MAGNETIC BLOCKS 25 PCS' :
        slug == 'magnetic-blocks-36-pcs' ? 'MAGNETIC BLOCKS 36 PCS' :
        slug == 'magnetic-blocks-42-pcs' ? 'MAGNETIC BLOCKS 42 PCS' :
        slug == 'magnetic-blocks-64-pcs' ? 'MAGNETIC BLOCKS 64 PCS' : '';
    }

    function defaultPriceForName(name) {
      return name == 'BUBBLE GUN' ? 499 :
        name == 'STUNT PET' ? 599 :
        name == 'MINI COOL CAR' ? 749 :
        name == 'GEL STORM' ? 1999 :
        name == 'MECHA ROVER' ? 499 :
        name == 'PIXEL SPLASH' ? 1749 :
        name == 'CUTE DINOS GREEN' ? 249 :
        name == 'CUTE DINOS RED' ? 249 :
        name == 'CUTE DINOS TEAL' ? 249 :
        name == 'CUTE DINOS TRIO' ? 549 :
        name == 'MAGNETIC BLOCKS 25 PCS' ? 399 :
        name == 'MAGNETIC BLOCKS 36 PCS' ? 549 :
        name == 'MAGNETIC BLOCKS 42 PCS' ? 599 :
        name == 'MAGNETIC BLOCKS 64 PCS' ? 799 : -1;
    }

    function isValidCatalogueItem(name, price) {
      return skuSlugForName(name) != '' &&
        (price is int || price is float) &&
        (
          exists(/databases/$(database)/documents/products/$(skuSlugForName(name)))
            ? price == get(/databases/$(database)/documents/products/$(skuSlugForName(name))).data.price
            : price == defaultPriceForName(name)
        );
    }

    function isValidPriceComparisonEntry(entry) {
      return entry is map &&
        entry.keys().hasAll(['platform', 'price']) &&
        entry.keys().hasOnly(['platform', 'price']) &&
        entry.platform is string &&
        entry.platform.size() >= 1 &&
        entry.platform.size() <= 32 &&
        (entry.price is int || entry.price is float) &&
        entry.price > 0 &&
        entry.price <= 500000;
    }

    function isValidPriceComparisonList(list) {
      return list is list &&
        list.size() <= 5 &&
        (list.size() < 1 || isValidPriceComparisonEntry(list[0])) &&
        (list.size() < 2 || isValidPriceComparisonEntry(list[1])) &&
        (list.size() < 3 || isValidPriceComparisonEntry(list[2])) &&
        (list.size() < 4 || isValidPriceComparisonEntry(list[3])) &&
        (list.size() < 5 || isValidPriceComparisonEntry(list[4]));
    }

    function isValidProductCatalogDoc(data, skuSlug) {
      return data.keys().hasAll([
          'sku', 'name', 'price', 'compareAtPrice', 'stock', 'lowStockThreshold',
          'cardTag', 'priceComparisons', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sku', 'name', 'price', 'compareAtPrice', 'stock', 'lowStockThreshold',
          'cardTag', 'priceComparisons', 'updatedAt'
        ]) &&
        data.sku is string && data.sku == skuSlug && isValidSkuSlug(skuSlug) &&
        data.name is string && data.name == nameForSkuSlug(skuSlug) &&
        (data.price is int || data.price is float) && data.price >= 1 && data.price <= 500000 &&
        (data.compareAtPrice is int || data.compareAtPrice is float) && data.compareAtPrice >= 0 && data.compareAtPrice <= 500000 &&
        data.stock is int && data.stock >= 0 && data.stock <= 100000 &&
        data.lowStockThreshold is int && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 10000 &&
        data.cardTag is string && data.cardTag.size() <= 32 &&
        isValidPriceComparisonList(data.priceComparisons) &&
        data.updatedAt is timestamp;
    }

    function isValidStockDecrement(nextData, prevData) {
      return nextData.diff(prevData).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
        nextData.stock is int &&
        prevData.stock is int &&
        nextData.stock >= 0 &&
        nextData.stock < prevData.stock &&
        (prevData.stock - nextData.stock) <= 99 &&
        nextData.updatedAt == request.time;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500 && (data.photoURL == '' || data.photoURL.matches('^https://.*')))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'fullName', 'phone', 'address', 'pinCode', 'city', 'state', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 120)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 10 && data.phone.matches('^$|^[6-9][0-9]{9}$'))) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('pinCode' in data) || (data.pinCode is string && data.pinCode.size() <= 6 && data.pinCode.matches('^$|^[1-9][0-9]{5}$'))) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
        (!('state' in data) || (data.state is string && data.state.size() <= 100)) &&
        data.updatedAt is timestamp;
    }

    function isValidCartItem(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'price', 'quantity', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'price', 'quantity', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (data.price is int || data.price is float) &&
        isValidCatalogueItem(data.name, data.price) &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 99 &&
        data.updatedAt is timestamp;
    }

    function isValidWishlistItem(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'href', 'price', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'name', 'href', 'image', 'price', 'createdAt']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.href is string && data.href.size() >= 1 && data.href.size() <= 200 && data.href.matches('^/[a-zA-Z0-9_\\-/?=&]+$') &&
        (!('image' in data) || (data.image is string && data.image.size() <= 300 && (data.image == '' || data.image.matches('^/[a-zA-Z0-9_\\-./?=&]+$')))) &&
        (data.price is int || data.price is float) &&
        isValidCatalogueItem(data.name, data.price) &&
        data.createdAt is timestamp;
    }

    function isValidProductSlug(slug) {
      return slug in [
        'bubble-gun',
        'stunt-pet',
        'mini-cool-car',
        'gel-storm',
        'mecha-rover',
        'pixel-splash',
        'cute-dinos',
        'magnetic-blocks'
      ];
    }

    function itemSlugMatchesProduct(itemSlug, productSlug) {
      return (productSlug == 'cute-dinos' && itemSlug in ['cute-dinos-green', 'cute-dinos-red', 'cute-dinos-teal', 'cute-dinos-trio']) ||
        (productSlug == 'magnetic-blocks' && itemSlug in ['magnetic-blocks-25-pcs', 'magnetic-blocks-36-pcs', 'magnetic-blocks-42-pcs', 'magnetic-blocks-64-pcs']) ||
        (productSlug != 'cute-dinos' && productSlug != 'magnetic-blocks' && itemSlug == productSlug);
    }

    function isValidOrderStatus(status) {
      return status in [
        'placed',
        'created',
        'processed',
        'shipped',
        'out_for_delivery',
        'delivered',
        'fulfilled',
        'cancelled'
      ];
    }

    function isValidOrder(data, userId) {
      return data.keys().hasAll([
          'uid', 'reference', 'customerName', 'email', 'phone', 'address', 'pin', 'city', 'state',
          'shippingMethod', 'shippingCost', 'freeShipping', 'freeGift', 'subtotal', 'gstRate', 'gst',
          'total', 'itemCount', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'reference', 'customerName', 'email', 'phone', 'address', 'pin', 'city', 'state',
          'shippingMethod', 'shippingCost', 'freeShipping', 'freeGift', 'subtotal', 'gstRate', 'gst',
          'total', 'itemCount', 'status', 'createdAt',
          'trackingCode', 'trackingCarrier', 'deliveredAt'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.reference is string && data.reference.size() == 15 && data.reference.matches('^RED-DEMO-[0-9]{6}$') &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.phone is string && data.phone.size() == 10 && data.phone.matches('^[6-9][0-9]{9}$') &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.pin is string && data.pin.size() == 6 && data.pin.matches('^[1-9][0-9]{5}$') &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 100 &&
        data.state is string && data.state.size() >= 1 && data.state.size() <= 100 &&
        data.shippingMethod in ['standard', 'express'] &&
        (data.shippingCost is int || data.shippingCost is float) && data.shippingCost >= 0 && data.shippingCost <= 500 &&
        data.freeShipping is bool &&
        data.freeGift is bool &&
        (data.subtotal is int || data.subtotal is float) && data.subtotal > 0 && data.subtotal <= 1000000 &&
        (data.gstRate is int || data.gstRate is float) && data.gstRate == 12 &&
        (data.gst is int || data.gst is float) && data.gst >= 0 && data.gst <= data.subtotal &&
        (data.total is int || data.total is float) && data.total == data.subtotal + data.shippingCost &&
        data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
        data.status is string && isValidOrderStatus(data.status) &&
        data.createdAt is timestamp &&
        (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 64)) &&
        (!('trackingCarrier' in data) || (data.trackingCarrier is string && data.trackingCarrier.size() <= 64)) &&
        (!('deliveredAt' in data) || data.deliveredAt is timestamp);
    }

    function isValidOrderItem(data, userId, orderId) {
      return data.keys().hasAll(['uid', 'orderId', 'name', 'price', 'quantity']) &&
        data.keys().hasOnly(['uid', 'orderId', 'name', 'price', 'quantity']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.orderId is string && data.orderId == orderId && isValidId(data.orderId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (data.price is int || data.price is float) &&
        isValidCatalogueItem(data.name, data.price) &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 99;
    }

    function isValidReviewCreate(data, productSlug, reviewId) {
      return data.keys().hasAll([
          'uid', 'orderId', 'orderReference', 'productSlug', 'itemSlug', 'productName',
          'authorName', 'rating', 'title', 'body', 'status', 'verifiedPurchase', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'orderId', 'orderReference', 'productSlug', 'itemSlug', 'productName',
          'authorName', 'rating', 'title', 'body', 'status', 'verifiedPurchase', 'createdAt'
        ]) &&
        isValidId(reviewId) &&
        data.uid is string && data.uid == request.auth.uid && isValidId(data.uid) &&
        data.orderId is string && isValidId(data.orderId) &&
        reviewId == data.uid + '__' + data.orderId + '__' + productSlug &&
        data.orderReference is string && data.orderReference.size() == 15 && data.orderReference.matches('^RED-DEMO-[0-9]{6}$') &&
        data.productSlug is string && data.productSlug == productSlug && isValidProductSlug(productSlug) &&
        data.itemSlug is string && itemSlugMatchesProduct(data.itemSlug, productSlug) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 80 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 5 && data.body.size() <= 1000 &&
        data.status == 'pending' &&
        data.verifiedPurchase == true &&
        data.createdAt == request.time;
    }

    // Collection-group read access for verified store admin to list all placed orders, customer reviews & customer wishlists
    match /{path=**}/orders/{orderId} {
      allow get: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin();
    }

    match /{path=**}/reviews/{reviewId} {
      allow get: if isValidId(reviewId) && isAdmin();
      allow list: if isAdmin();
    }

    match /{path=**}/wishlist/{itemId} {
      allow get: if isValidId(itemId) && isAdmin();
      allow list: if isAdmin();
    }

    match /products/{skuSlug} {
      allow get: if isValidSkuSlug(skuSlug);
      allow list: if true;
      allow create: if isAdmin() && isValidSkuSlug(skuSlug) &&
        isValidProductCatalogDoc(incoming(), skuSlug) &&
        incoming().updatedAt == request.time;
      allow update: if isValidSkuSlug(skuSlug) && (
        (isAdmin() &&
          isValidProductCatalogDoc(incoming(), skuSlug) &&
          incoming().sku == existing().sku &&
          incoming().name == existing().name &&
          incoming().updatedAt == request.time) ||
        (isVerified() && isValidStockDecrement(incoming(), existing()))
      );
      allow delete: if false;
    }

    match /products/{productSlug}/reviews/{reviewId} {
      allow get: if isValidId(reviewId) && isValidProductSlug(productSlug) && (
        resource.data.status == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid)
      );
      allow list: if isValidProductSlug(productSlug) && (
        resource.data.status == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid)
      );
      allow create: if isVerified() && isValidProductSlug(productSlug) &&
        isValidReviewCreate(incoming(), productSlug, reviewId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(incoming().orderId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(incoming().orderId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(incoming().orderId)).data.status in ['delivered', 'fulfilled'] &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(incoming().orderId)/items/$(incoming().itemSlug));
      allow update: if isAdmin() && isValidId(reviewId) && isValidProductSlug(productSlug) &&
        incoming().uid == existing().uid &&
        incoming().orderId == existing().orderId &&
        incoming().orderReference == existing().orderReference &&
        incoming().productSlug == existing().productSlug &&
        incoming().itemSlug == existing().itemSlug &&
        incoming().productName == existing().productName &&
        incoming().authorName == existing().authorName &&
        incoming().rating == existing().rating &&
        incoming().title == existing().title &&
        incoming().body == existing().body &&
        incoming().verifiedPurchase == existing().verifiedPurchase &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'moderatedAt']) &&
        incoming().status in ['pending', 'approved', 'rejected'] &&
        (!('moderatedAt' in incoming()) || incoming().moderatedAt is timestamp);
      allow delete: if isAdmin() && isValidId(reviewId) && isValidProductSlug(productSlug);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedOwner(userId) && isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId) && isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'profile' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isVerifiedOwner(userId) && isValidId(userId) && docId == 'profile' &&
          isValidPrivateProfile(incoming(), userId) &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId) && isValidId(userId) && docId == 'profile' &&
          isValidPrivateProfile(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'fullName', 'phone', 'address', 'pinCode', 'city', 'state', 'updatedAt']);
        allow delete: if false;
      }

      match /cart/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(itemId) &&
          isValidCartItem(incoming(), userId) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(itemId) &&
          isValidCartItem(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().name == existing().name &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'price', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(itemId);
      }

      match /wishlist/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.uid == request.auth.uid);
        allow create: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(itemId) &&
          isValidWishlistItem(incoming(), userId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(itemId);
      }

      match /orders/{orderId} {
        allow get: if isValidId(userId) && isValidId(orderId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.uid == request.auth.uid);
        allow create: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(orderId) &&
          isValidOrder(incoming(), userId) &&
          incoming().uid == request.auth.uid &&
          incoming().status == 'placed' &&
          incoming().createdAt == request.time &&
          !('deliveredAt' in incoming()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isAdmin() && isValidId(userId) && isValidId(orderId) &&
          isValidOrder(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().reference == existing().reference &&
          incoming().gstRate == existing().gstRate &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'customerName', 'email', 'phone', 'address', 'pin', 'city', 'state',
            'shippingMethod', 'shippingCost', 'freeShipping', 'freeGift',
            'subtotal', 'gst', 'total', 'itemCount', 'status',
            'trackingCode', 'trackingCarrier', 'deliveredAt'
          ]);
        allow delete: if false;

        match /items/{itemId} {
          allow get: if isValidId(userId) && isValidId(orderId) && isValidId(itemId) && (
            isAdmin() ||
            (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)).data.uid == request.auth.uid)
          );
          allow list: if isAdmin() || (isOwner(userId) && resource.data.uid == request.auth.uid);
          allow create: if isValidId(userId) && isValidId(orderId) && isValidId(itemId) &&
            isValidOrderItem(incoming(), userId, orderId) &&
            existsAfter(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)) && (
              (isVerifiedOwner(userId) && incoming().uid == request.auth.uid &&
                getAfter(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)).data.uid == request.auth.uid) ||
              isAdmin()
            );
          allow update: if isAdmin() && isValidId(userId) && isValidId(orderId) && isValidId(itemId) &&
            isValidOrderItem(incoming(), userId, orderId) &&
            incoming().uid == existing().uid &&
            incoming().orderId == existing().orderId &&
            incoming().name == existing().name &&
            existsAfter(/databases/$(database)/documents/users/$(userId)/orders/$(orderId));
          allow delete: if isAdmin() && isValidId(userId) && isValidId(orderId) && isValidId(itemId);
        }
      }
    }
  }
}
